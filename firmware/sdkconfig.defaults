CONFIG_IDF_TARGET="esp32s3"

# Carte par defaut : Freenove ESP32-S3-WROOM CAM (N16R8 : flash 16 Mo, PSRAM octale 8 Mo)
# Pour la XIAO : idf.py -D SDKCONFIG_DEFAULTS="sdkconfig.defaults;sdkconfig.defaults.xiao" build
CONFIG_BADPOSTURE_BOARD_FREENOVE=y
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_USE_MALLOC=y

# Performances
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_COMPILER_OPTIMIZATION_PERF=y
CONFIG_ESP32S3_DATA_CACHE_64KB=y
CONFIG_ESP32S3_DATA_CACHE_LINE_64B=y
CONFIG_ESP32S3_INSTRUCTION_CACHE_32KB=y

# Partitions
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# Modele de pose : YOLO11n-pose V2 (QAT) embarque en flash
CONFIG_FLASH_COCO_POSE_YOLO11N_POSE_S8_V2=y
CONFIG_COCO_POSE_YOLO11N_POSE_S8_V2=y
CONFIG_COCO_POSE_MODEL_IN_FLASH_RODATA=y

# Camera
CONFIG_CAMERA_TASK_STACK_SIZE=4096

# Console : UART0 (port "UART" Freenove) + copie sur l'USB natif (port "USB" Freenove, XIAO)
CONFIG_ESP_CONSOLE_UART_DEFAULT=y
CONFIG_ESP_CONSOLE_SECONDARY_USB_SERIAL_JTAG=y
CONFIG_ESP_MAIN_TASK_STACK_SIZE=16384
