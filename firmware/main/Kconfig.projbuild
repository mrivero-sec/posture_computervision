menu "BAD POSTURE"

    choice BADPOSTURE_BOARD
        prompt "Carte cible"
        default BADPOSTURE_BOARD_FREENOVE
        help
            Choisit le brochage camera / LED / buzzer / bouton.

        config BADPOSTURE_BOARD_FREENOVE
            bool "Freenove ESP32-S3-WROOM CAM (N16R8, 16 Mo flash)"
        config BADPOSTURE_BOARD_XIAO
            bool "Seeed XIAO ESP32S3 Sense (8 Mo flash)"
    endchoice

    choice BADPOSTURE_ROTATE
        prompt "Rotation camera (sens horaire)"
        default BADPOSTURE_ROTATE_270
        help
            270 = carte posee en portrait (montage de profil au bureau), comme
            camera.rotate dans config.yaml. La personne doit apparaitre debout.

        config BADPOSTURE_ROTATE_0
            bool "0 (paysage)"
        config BADPOSTURE_ROTATE_90
            bool "90"
        config BADPOSTURE_ROTATE_180
            bool "180"
        config BADPOSTURE_ROTATE_270
            bool "270 (portrait)"
    endchoice

endmenu
